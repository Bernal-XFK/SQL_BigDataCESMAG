# Copia a .env.local para desarrollo (no se versiona .env.local).
# URL pública de la Cloud Function executions-api (sin secretos aquí).
VITE_API_URL=http://localhost:8080
# VITE_API_URL=https://us-central1-TU_PROJECT.cloudfunctions.net/executions-api
# Intervalo de polling del dashboard en milisegundos (default 30000).
VITE_REFRESH_MS=30000
